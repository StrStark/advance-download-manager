{
  "manifest_version": 3,
  "name": "ADM: Download with ADM",
  "short_name": "ADM",
  "version": "0.2.0",
  "description": "Send your downloads to ADM (Advance Download Manager) for faster, resumable, multi-connection downloading.",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["downloads", "nativeMessaging", "cookies", "contextMenus", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
