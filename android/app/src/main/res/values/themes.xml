<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light variant; values-night/ has the dark one. The WebView reports
         prefers-color-scheme from this theme, so the UI follows the system. -->
    <style name="Theme.ADM" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
